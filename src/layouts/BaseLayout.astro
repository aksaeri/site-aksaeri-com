---
import '../styles/brand.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Alexander K Saeri',
  description = 'I direct the MIT AI Risk Initiative, building the evidence base that decision-makers need to manage the most important risks from AI.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alexander K Saeri',
  alternateName: ['Alexander Saeri', 'Alex Saeri'],
  url: 'https://aksaeri.com/',
  jobTitle: 'Director, MIT AI Risk Initiative',
  worksFor: { '@type': 'Organization', name: 'MIT FutureTech', url: 'https://futuretech.mit.edu/' },
  affiliation: { '@type': 'CollegeOrUniversity', name: 'The University of Queensland', url: 'https://www.uq.edu.au/' },
  homeLocation: { '@type': 'Place', name: 'Melbourne, Australia' },
  sameAs: [
    'https://orcid.org/0000-0001-9254-0300',
    'https://scholar.google.com.au/citations?user=B_bJG3kAAAAJ',
    'https://www.linkedin.com/in/aksaeri',
    'https://github.com/aksaeri',
    'https://airisk.mit.edu/team/alexander-k-saeri',
  ],
};
---

<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  {noindex ? (
    <meta name="robots" content="noindex">
  ) : (
    <>
      <link rel="canonical" href={canonical}>
      <meta property="og:type" content="profile">
      <meta property="og:site_name" content="Alexander K Saeri">
      <meta property="og:locale" content="en_AU">
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
      <meta property="og:url" content={canonical}>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content="Alexander K Saeri: AI risk research for decision-makers">
      <meta name="twitter:card" content="summary_large_image">
      <script type="application/ld+json" set:html={JSON.stringify(person)} />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico">
  <script is:inline>
    (function() {
      try {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
      } catch (e) {}
    })();
  </script>
  <style is:global>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      -webkit-text-size-adjust: 100%;
      scroll-padding-top: 1.5rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }
    }

    /* Accessible accent for teal text, links and buttons. Brand teal (#17879B)
       is 4.04:1 on the background, under the WCAG AA 4.5:1 minimum for text;
       #127788 is 5.0:1 (5.2:1 under white button text). */

    :root {
      --color-accent-text: #127788;
      --color-link: var(--color-accent-text);
      --color-button: var(--color-accent-text);
      --color-button-hover: var(--color-primary-dark);
      --color-button-text: #FFFFFF;
    }

    /* Dark mode overrides (extends brand.css tokens) */

    :root[data-theme="dark"] {
      --color-background: #161616;
      --color-text: #EAEAEA;
      --color-text-muted: #A6A6A6;
      --color-border: #2A2A2A;
      --color-border-strong: #444444;
      --color-white: #1F1F1F;
      --color-primary-dark: #2BA0B8;
      --color-accent-text: #5FAFBE;
      --color-link: #5FAFBE;
      --color-link-hover: #80CAD9;
      --color-button: #5FAFBE;
      --color-button-hover: #80CAD9;
      --color-button-text: #161616;
    }

    body {
      font-family: var(--font-family);
      font-weight: var(--font-weight-regular);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--color-text);
      background: var(--color-background);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Shell: bicolumn on desktop, stacked on mobile */

    .shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.25rem;
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas:
        "header"
        "main"
        "meta"
        "footer";
      column-gap: 0;
    }

    @media (min-width: 851px) {
      .shell {
        grid-template-columns: 260px 1px 1fr;
        grid-template-areas:
          "sidebar rule main"
          "footer  footer footer";
        column-gap: 3rem;
        padding: 0 2rem;
      }
    }

    /* Sidebar wrapper: bundles header + meta on desktop, dissolves on mobile */

    .sidebar-content {
      display: contents;
    }

    @media (min-width: 851px) {
      .sidebar-content {
        display: block;
        grid-area: sidebar;
        position: sticky;
        top: 3rem;
        align-self: start;
        padding: 3rem 0;
      }
    }

    /* Header */

    .site-header {
      grid-area: header;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "mark toggle"
        "nav  nav";
      align-items: center;
      column-gap: 1rem;
      padding: 0.5rem 0 0.25rem;
      border-bottom: 1px solid var(--color-border);
    }

    @media (min-width: 851px) {
      .site-header {
        display: block;
        padding: 0 0 1.5rem 0;
        border-bottom: none;
      }
    }

    .wordmark {
      grid-area: mark;
      font-family: var(--font-family);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
      letter-spacing: -0.01em;
      color: var(--color-accent-text);
      text-decoration: none;
      line-height: 1.2;
    }

    .wordmark:hover {
      color: var(--color-link-hover);
      text-decoration: none;
    }

    @media (min-width: 851px) {
      .wordmark {
        display: block;
        font-size: 1.0625rem;
        margin-bottom: 0.25rem;
      }
    }

    .site-tagline {
      display: none;
    }

    @media (min-width: 851px) {
      .site-tagline {
        display: block;
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
        line-height: 1.5;
        margin-bottom: 1.75rem;
      }
    }

    .site-nav {
      grid-area: nav;
      display: flex;
      gap: 0 1rem;
      flex-wrap: wrap;
    }

    .site-nav a {
      color: var(--color-text);
      text-decoration: none;
      font-size: var(--font-size-sm);
      padding: 0.5rem 0;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .site-nav a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    @media (min-width: 851px) {
      .site-nav {
        flex-direction: column;
        gap: 0;
        margin-bottom: 2rem;
      }

      .site-nav a {
        padding: 0.4rem 0 0.4rem 0.75rem;
        margin-left: -0.75rem;
        min-height: 0;
      }
    }

    /* Vertical rule (desktop only) */

    .site-rule {
      display: none;
    }

    @media (min-width: 851px) {
      .site-rule {
        display: block;
        grid-area: rule;
        background: var(--color-border);
        width: 1px;
        align-self: stretch;
      }
    }

    /* Main column */

    main {
      grid-area: main;
      min-width: 0;
      padding: 1.5rem 0 2rem;
    }

    @media (min-width: 851px) {
      main {
        padding: 3rem 0 4rem;
      }
    }

    /* Lead block (intro/hero) */

    .lead-block {
      margin-bottom: 2.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    .lead-block h1 {
      font-size: 1.75rem;
      font-weight: var(--font-weight-bold);
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
      max-width: 18ch;
    }

    @media (min-width: 851px) {
      .lead-block h1 {
        font-size: 2.25rem;
      }
    }

    .lead-block .lede {
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--color-text);
      max-width: 42em;
      margin-bottom: 1rem;
    }

    .lead-block .lede strong { font-weight: var(--font-weight-semibold); color: var(--color-accent-text); }

    /* Sections */

    .section {
      margin-bottom: 2.5rem;
    }

    @media (min-width: 851px) {
      .section {
        margin-bottom: 3rem;
      }
    }

    /* Typography (general) */

    h1, h2, h3, h4 {
      font-family: var(--font-family);
      color: var(--color-text);
      letter-spacing: -0.01em;
      line-height: 1.25;
    }

    h2 {
      font-size: 1.375rem;
      font-weight: var(--font-weight-semibold);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }

    @media (min-width: 851px) {
      h2 {
        font-size: 1.5rem;
      }
    }

    h3 {
      font-size: 1.125rem;
      font-weight: var(--font-weight-semibold);
      margin-top: 2rem;
      margin-bottom: 0.5rem;
    }

    p {
      margin-bottom: 1rem;
      overflow-wrap: anywhere;
    }

    a {
      color: var(--color-link);
      text-decoration: none;
    }

    a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    main a:not(.btn) {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }

    :focus-visible {
      outline: 2px solid var(--color-link);
      outline-offset: 2px;
    }

    ul, ol {
      margin-bottom: 1rem;
      padding-left: 1.25rem;
    }

    li {
      margin-bottom: 0.5rem;
    }

    hr {
      border: none;
      border-top: 1px solid var(--color-border);
      margin: 1.5rem 0;
    }

    img {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-md);
    }

    /* Header banner (wide section/page hero photos) */

    .header-banner {
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      object-fit: cover;
      object-position: center;
      border-radius: var(--radius-md);
      margin: 2rem 0;
      display: block;
    }

    @media (min-width: 851px) {
      .header-banner {
        margin: 2.5rem 0;
      }
    }

    /* Workstream cards (AIRI section) */

    ul.workstreams {
      list-style: none;
      padding-left: 0;
      margin: 1.75rem 0 2rem;
    }

    ul.workstreams li {
      padding: 0.1rem 0 0.4rem 1.25rem;
      border-left: 2px solid var(--color-primary);
      margin-bottom: 1.5rem;
    }

    ul.workstreams li:last-child {
      margin-bottom: 0;
    }

    .workstream-name {
      display: block;
      width: fit-content;
      font-size: 1.0625rem;
      font-weight: var(--font-weight-semibold);
      color: var(--color-text);
      letter-spacing: -0.005em;
      margin-bottom: 0.25rem;
    }

    a.workstream-name {
      color: var(--color-link);
    }

    .workstream-q {
      font-size: var(--font-size-sm);
      color: var(--color-text-muted);
      margin-bottom: 0.35rem;
    }

    .workstream-a {
      font-size: var(--font-size-base);
      margin-bottom: 0;
    }

    /* Publications list */

    ul.publications {
      list-style: none;
      padding-left: 0;
    }

    ul.publications li {
      padding: 0.4rem 0 0.6rem 0;
      font-size: var(--font-size-sm);
      line-height: 1.55;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 0;
    }

    ul.publications li:last-child {
      border-bottom: none;
    }

    @media (min-width: 851px) {
      ul.publications li {
        font-size: var(--font-size-base);
      }
    }

    /* Buttons */

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.875rem 1.5rem;
      background: var(--color-button);
      color: var(--color-button-text);
      text-decoration: none;
      border-radius: var(--radius-md);
      font-weight: var(--font-weight-semibold);
      font-size: var(--font-size-sm);
      border: 1.5px solid var(--color-button);
      min-height: 44px;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .btn:hover {
      background: var(--color-button-hover);
      border-color: var(--color-button-hover);
      color: var(--color-button-text);
      text-decoration: none;
    }

    .btn-outline {
      background: transparent;
      color: var(--color-accent-text);
      border-color: var(--color-accent-text);
    }

    .btn-outline:hover {
      background: rgba(23, 135, 155, 0.08);
      color: var(--color-link-hover);
      border-color: var(--color-link-hover);
    }

    /* Meta block (sidebar items: affiliations, location, elsewhere) */

    .site-meta {
      grid-area: meta;
      padding-top: 2rem;
      margin-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    @media (min-width: 851px) {
      .site-meta {
        padding-top: 0;
        margin-top: 0;
        border-top: none;
      }
    }

    .meta-block {
      margin-bottom: 1.5rem;
    }

    .meta-block:last-child {
      margin-bottom: 0;
    }

    .meta-label {
      display: block;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--color-text-muted);
      font-weight: var(--font-weight-semibold);
      margin-bottom: 0.4rem;
    }

    .meta-block p, .meta-block ul {
      font-size: var(--font-size-sm);
      line-height: 1.55;
      margin-bottom: 0;
    }

    .meta-block ul {
      list-style: none;
      padding-left: 0;
    }

    .meta-block ul li {
      margin-bottom: 0.4rem;
    }

    .meta-block a {
      color: var(--color-link);
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .meta-block a:hover {
      color: var(--color-link-hover);
      text-decoration: underline;
    }

    /* Footer */

    .site-footer {
      grid-area: footer;
      padding: 2rem 0;
      border-top: 1px solid var(--color-border);
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    /* Theme toggle */

    .theme-toggle {
      grid-area: toggle;
      background: transparent;
      border: 0;
      padding: 0.5rem;
      cursor: pointer;
      color: var(--color-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
      border-radius: var(--radius-sm);
    }

    .theme-toggle:hover {
      color: var(--color-accent-text);
    }

    .theme-toggle .theme-icon-moon { display: none; }

    :root[data-theme="dark"] .theme-toggle .theme-icon-sun { display: none; }
    :root[data-theme="dark"] .theme-toggle .theme-icon-moon { display: inline; }

    @media (min-width: 851px) {
      .theme-toggle {
        margin: 0.5rem 0 1.5rem -0.5rem;
        align-self: flex-start;
      }
    }

    /* Skip link (accessibility) */

    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      background: var(--color-button);
      color: var(--color-button-text);
      padding: 0.5rem 1rem;
      z-index: 100;
    }

    .skip-link:focus {
      left: 1rem;
      top: 1rem;
    }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="shell">
    <div class="sidebar-content">
      <header class="site-header">
        <a href="/" class="wordmark">Alexander K Saeri</a>
        <p class="site-tagline">AI governance researcher</p>
        <nav class="site-nav" aria-label="Primary">
          <a href="/#about">About</a>
          <a href="/#airi">AI Risk Initiative</a>
          <a href="/#publications">Publications</a>
          <a href="/#contact">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
          <svg class="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </header>

      <aside class="site-meta" aria-label="Profile metadata">
        <div class="meta-block">
          <span class="meta-label">Affiliations</span>
          <p>MIT FutureTech<br>The University of Queensland</p>
        </div>
        <div class="meta-block">
          <span class="meta-label">Based in</span>
          <p>Melbourne, Australia (UTC+10)</p>
        </div>
        <div class="meta-block">
          <span class="meta-label">Elsewhere</span>
          <ul>
            <li><a href="/cv">CV</a></li>
            <li><a href="https://scholar.google.com.au/citations?user=B_bJG3kAAAAJ">Google Scholar</a></li>
            <li><a href="https://www.linkedin.com/in/aksaeri">LinkedIn</a></li>
            <li><a href="https://github.com/aksaeri">GitHub</a></li>
            <li><a href="https://tools.aksaeri.com/">AI tools</a></li>
            <li><a href="https://airisk.mit.edu">airisk.mit.edu</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <div class="site-rule" aria-hidden="true"></div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Alexander K Saeri</p>
    </footer>
  </div>
  <script is:inline>
    // Theme toggle
    var themeBtn = document.querySelector('.theme-toggle');
    if (themeBtn) {
      var syncPressed = function() {
        themeBtn.setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'dark'));
      };
      syncPressed();
      themeBtn.addEventListener('click', function() {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        syncPressed();
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    }
  </script>
</body>
</html>
