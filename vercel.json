{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/meet",
      "destination": "https://calendar.app.google/sv3Sb5sjUxxTdssv8",
      "permanent": true
    },
    {
      "source": "/opportunities",
      "destination": "https://docs.google.com/document/d/1TRfgYpy8dOTXU_KJpqq1ZkBIUKqpyOaW6vBqufpRqGw/edit",
      "permanent": true
    },
    {
      "source": "/eoi",
      "destination": "https://forms.gle/6BEMc3DYuU52yfGn8",
      "permanent": true
    },
    {
      "source": "/intro",
      "destination": "https://docs.google.com/document/d/1UjL4NztBiiTYw7p-HZrefE2XocCSKZ77WEOQ-P3LoH0/copy",
      "permanent": true
    },
    {
      "source": "/cv",
      "destination": "https://docs.google.com/document/d/1gFzs19rKbZ0QyBxlqyPEElTojDjMm3LwvJx7Ah-D3H0/edit",
      "permanent": true
    },
    {
      "source": "/project/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/publication/:path*",
      "destination": "/#publications",
      "permanent": true
    },
    {
      "source": "/post/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/event/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/authors/:path*",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/other_projects",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/other-projects",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    }
  ]
}
